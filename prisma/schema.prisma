generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model ships {
  id          Int     @id @default(autoincrement())
  extId       Int
  name        String  @db.VarChar(255)
  img         String? @db.VarChar(255)
  anotation   String? @db.Text
  about       String? @db.Text
  services    String? @db.Text
  images      String? @db.Text
  loadFrom    String  @db.VarChar(255)
  scheme      String? @db.VarChar(255)
  active      Int
  description String? @db.Text
  captain     String? @db.Text
  cabinsPhoto Json?
  class       String? @db.VarChar(255)
  type        String? @db.VarChar(255)
  provider    String? @db.VarChar(255)
}

model cruises {
  id               Int      @id @unique @default(autoincrement())
  extId            Int
  title            String   @db.Text
  dateStart        DateTime @db.DateTime(0)
  dateEnd          DateTime @db.DateTime(0)
  cityStart        String   @db.VarChar(255)
  cityEnd          String   @db.VarChar(255)
  days             Int
  route            Json
  shortRoute       String   @db.Text
  shipId           Int
  shipName         String   @db.VarChar(255)
  loadFrom         String   @db.VarChar(255)
  created_at       DateTime @default(now()) @db.Timestamp(0)
  citiesInRoute    Json
  extShipId        Int
  minPrice         Int
  minDiscountPrice Int
  prices           Json?
  description      String   @db.Text
  restaurants      String?  @db.Text
  included         String?  @db.Text
  excluded         String?  @db.Text
  image            String   @db.VarChar(255)
  class            String?  @db.VarChar(255)
  type             String?  @db.VarChar(255)
  provider         String?  @db.VarChar(255)
  shipImg          String?  @db.VarChar(255)
}

model blog {
  id      Int       @id @default(autoincrement())
  title   String    @db.VarChar(255)
  date    DateTime? @db.DateTime(0)
  content String?   @db.Text
  images  String?   @db.Text
  preview String?   @db.Text
  publish String?   @db.VarChar(255)
}

model news {
  id      Int       @id @default(autoincrement())
  title   String    @db.VarChar(255)
  date    DateTime? @db.DateTime(0)
  content String?   @db.Text
  image   String?   @db.Text
  preview String?   @db.Text
  publish String?   @db.VarChar(255)
}

model pages {
  id          Int     @id @default(autoincrement())
  title       String? @db.VarChar(255)
  images      String? @db.VarChar(255)
  slug        String  @unique(map: "compilation_slug_key") @db.VarChar(255)
  query       Json?
  content     String? @db.MediumText
  active      Int
  metaTag     Json?
  itemsOnPage Int?
}

model admins {
  id    Int     @id @default(autoincrement())
  email String  @db.VarChar(255)
  role  String? @db.VarChar(255)
}

model hero {
  id          Int    @id @default(autoincrement())
  active      Int
  title       String @db.Text
  description String @db.Text
  img         String @db.VarChar(255)
  link        String @db.VarChar(255)
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model recommendations {
  id    Int?
  query Json?

  @@ignore
}
