generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model ships {
  id        Int     @id @default(autoincrement())
  extId     Int
  name      String  @db.VarChar(255)
  img       String? @db.VarChar(255)
  anotation String? @db.Text
  about     String? @db.Text
  services  String? @db.Text
  images    String? @db.Text   
  loadFrom  String  @db.VarChar(255)
  scheme    String? @db.VarChar(255)
}

model cruises {
  id         Int      @unique @default(autoincrement())
  exId       Int
  title      String   @db.Text
  dateStart  String   @db.VarChar(255)
  dateEnd    String   @db.VarChar(255)
  cityStart  String   @db.VarChar(255)
  cityEnd    String   @db.VarChar(255)
  days       Int
  route      String   @db.Text
  shortRoute String   @db.Text
  shipId     Int
  shipName   String   @db.VarChar(255)
  type       String   @db.VarChar(255)
  loadFrom   String   @db.VarChar(255)
  created_at DateTime @default(now()) @db.Timestamp(0)

  @@id([id, exId])
}
